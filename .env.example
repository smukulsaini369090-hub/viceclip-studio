# ═══════════════════════════════════════════════════════════════════════════════
# VICECLIP STUDIO — Environment Configuration
# Copy this file to .env and customize as needed
# ═══════════════════════════════════════════════════════════════════════════════

# ── GEMINI API ────────────────────────────────────────────────────────────────
# Get your free key at: https://aistudio.google.com/
# (Optional: Leave blank to use 100% Free Offline Heuristic Mode with zero API key)
GEMINI_API_KEY=
GEMINI_FAST_MODEL=gemini-3.5-flash-lite
GEMINI_DEEP_MODEL=gemini-3.5-flash-lite

# ── PATHS (Leave blank for auto-discovery relative to project root) ─────────────
WORKSPACE_DIR=
OUTPUT_DIR=
CACHE_DIR=
ASSETS_DIR=

# ── FFMPEG / ENCODING ────────────────────────────────────────────────────────
# Auto-discovered from WinGet or system PATH if left as "ffmpeg"
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe
NVENC_PRESET=p4
NVENC_CQ=19
NVENC_BITRATE=10M
TARGET_FPS=60

# ── WHISPER / TRANSCRIPTION ──────────────────────────────────────────────────
# Sizes: tiny, base, small, medium, large-v3
WHISPER_MODEL_SIZE=small
WHISPER_COMPUTE_TYPE=int8_float16
WHISPER_DEVICE=cuda

# ── NETWORK PORTS ────────────────────────────────────────────────────────────
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
FRONTEND_PORT=3000
