# ═══════════════════════════════════════════════════════════════════════════════
# VICECLIP STUDIO — .gitignore
# ═══════════════════════════════════════════════════════════════════════════════

# Python Virtual Environments
.venv/
venv/
env/
ENV/
.env.local
.env.*.local

# Sensitive API Keys & Config
.env

# Python Bytecode & Cache
__pycache__/
*.py[cod]
*$py.class
*.so
.pytest_cache/
.coverage
htmlcov/
dist/
build/
*.egg-info/

# Local Storage, Media & Database Cache (Do NOT commit large media)
cache/
output/
*.mp4
*.m4a
*.wav
*.part
*.ytdl
*.db
*.db-shm
*.db-wal

# Frontend (Next.js & Node)
frontend/node_modules/
frontend/.next/
frontend/out/
frontend/build/
frontend/tsconfig.tsbuildinfo
frontend/.vercel/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# OS & Editor Files
.DS_Store
Thumbs.db
desktop.ini
*.swp
*.swo
.vscode/
.idea/
*.log
