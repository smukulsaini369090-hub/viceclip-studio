from __future__ import annotations

import asyncio
import os
import shutil
import subprocess
import tempfile
from pathlib import Path
from typing import Any

import librosa
import numpy as np


def _ffmpeg_bin() -> str:
    found = shutil.which("ffmpeg")
    if found:
        return found
    for root in [
        os.environ.get("LOCALAPPDATA", ""),
        r"C:\Program Files",
        r"C:\ffmpeg",
    ]:
        if not root or not os.path.exists(root):
            continue
        for dirpath, _, filenames in os.walk(root):
            if "ffmpeg.exe" in filenames:
                return os.path.join(dirpath, "ffmpeg.exe")
    return "ffmpeg"


def _load_mono_audio(audio_path: str | Path, sr: int = 22050) -> tuple[np.ndarray, int]:
    src = Path(audio_path)
    try:
        y, actual_sr = librosa.load(str(src), sr=sr, mono=True)
        return np.asarray(y, dtype=np.float32), int(actual_sr)
    except Exception:
        tmp_wav = Path(tempfile.gettempdir()) / f"viceclip_sig_{os.getpid()}_{src.stem}.wav"
        ff = _ffmpeg_bin()
        cmd = [
            ff,
            "-y",
            "-v",
            "error",
            "-i",
            str(src),
            "-ac",
            "1",
            "-ar",
            str(sr),
            "-f",
            "wav",
            str(tmp_wav),
        ]
        create_no_window = 0x08000000 if os.name == "nt" else 0
        subprocess.run(cmd, check=True, creationflags=create_no_window)
        try:
            y, actual_sr = librosa.load(str(tmp_wav), sr=sr, mono=True)
            return np.asarray(y, dtype=np.float32), int(actual_sr)
        finally:
            if tmp_wav.exists():
                try:
                    tmp_wav.unlink()
                except OSError:
                    pass


def _analyse_audio_sync(audio_path: str, sr: int = 22050, hop_length: int = 512) -> list[dict[str, Any]]:
    y, actual_sr = _load_mono_audio(audio_path, sr=sr)
    if y.size == 0:
        return []
    rms = librosa.feature.rms(y=y, hop_length=hop_length)[0]
    times = librosa.frames_to_time(np.arange(len(rms)), sr=actual_sr, hop_length=hop_length)
    mean_rms = float(np.mean(rms))
    std_rms = float(np.std(rms))
    threshold = mean_rms + (1.5 * std_rms)

    spikes: list[dict[str, Any]] = []
    for t, val in zip(times, rms):
        if float(val) > threshold and mean_rms > 0:
            spikes.append({
                "timestamp": round(float(t), 2),
                "intensity": round(float(val / mean_rms), 3),
                "rms": round(float(val), 5),
            })
    return spikes


def _analyse_visual_sync(video_path: str, sample_fps: float = 2.0) -> list[dict[str, Any]]:
    import cv2

    cap = cv2.VideoCapture(video_path)
    if not cap.isOpened():
        return []
    try:
        native_fps = cap.get(cv2.CAP_PROP_FPS) or 30.0
        total_frames = int(cap.get(cv2.CAP_PROP_FRAME_COUNT) or 0)
        duration = total_frames / native_fps if native_fps > 0 else 0.0
        step = max(1, int(round(native_fps / max(0.5, sample_fps))))

        prev_gray = None
        diffs: list[tuple[float, float]] = []
        frame_idx = 0

        while True:
            ret, frame = cap.read()
            if not ret:
                break
            if frame_idx % step == 0:
                gray = cv2.cvtColor(frame, cv2.COLOR_BGR2GRAY)
                gray = cv2.resize(gray, (320, 180))
                if prev_gray is not None:
                    diff = float(np.mean(np.abs(gray.astype(np.float32) - prev_gray.astype(np.float32))))
                    ts = frame_idx / native_fps if native_fps > 0 else 0.0
                    diffs.append((round(ts, 2), diff))
                prev_gray = gray
            frame_idx += 1

        if not diffs:
            return []

        vals = np.array([d[1] for d in diffs], dtype=np.float32)
        mean_v = float(np.mean(vals))
        std_v = float(np.std(vals))
        thresh = mean_v + (1.5 * std_v)

        visual_spikes: list[dict[str, Any]] = []
        for ts, val in diffs:
            if val > thresh and mean_v > 0:
                visual_spikes.append({
                    "timestamp": ts,
                    "velocity": round(float(val / mean_v), 3),
                    "diff": round(float(val), 2),
                    "duration": round(duration, 2),
                })
        return visual_spikes
    finally:
        cap.release()


async def detect_audio_spikes(audio_path: str, sr: int = 22050) -> list[dict[str, Any]]:
    loop = asyncio.get_running_loop()
    return await loop.run_in_executor(None, _analyse_audio_sync, audio_path, sr)


async def detect_visual_spikes(video_path: str, sample_fps: float = 2.0) -> list[dict[str, Any]]:
    loop = asyncio.get_running_loop()
    return await loop.run_in_executor(None, _analyse_visual_sync, video_path, sample_fps)


async def analyse_signals(video_path: str, audio_path: str) -> tuple[list[dict[str, Any]], list[dict[str, Any]]]:
    audio_spikes, visual_spikes = await asyncio.gather(
        detect_audio_spikes(audio_path),
        detect_visual_spikes(video_path),
    )
    return audio_spikes, visual_spikes
